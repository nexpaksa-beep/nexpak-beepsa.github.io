<style>
  :root {
    --primary: #2563eb;
    --dark: #0f172a;
    --text: #1f2937;
    --light: #f8fafc;
    --accent: #f59e0b;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Inter', sans-serif;
  }

  body {
    background: var(--light);
    color: var(--text);
    line-height: 1.6;
  }

  /* HERO */
  .hero {
    background: linear-gradient(135deg, var(--dark), var(--primary));
    color: white;
    padding: 90px 20px;
    text-align: center;
  }

  .hero h1 {
    font-size: 44px;
    margin-bottom: 10px;
  }

  .hero p {
    max-width: 700px;
    margin: auto;
    opacity: 0.9;
    font-size: 18px;
  }

  .btn {
    display: inline-block;
    margin-top: 20px;
    padding: 12px 26px;
    background: var(--accent);
    color: #111;
    font-weight: 600;
    text-decoration: none;
    border-radius: 6px;
    transition: 0.3s;
  }

  .btn:hover {
    background: #d97706;
  }

  /* SECTIONS */
  .section {
    max-width: 1100px;
    margin: auto;
    padding: 60px 20px;
  }

  h2 {
    color: var(--primary);
    margin-bottom: 15px;
    font-size: 28px;
  }

  p {
    margin-bottom: 12px;
  }

  /* GRID */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    margin-top: 25px;
  }

  .card {
    background: white;
    padding: 20px;
    border-radius: 10px;
    border: 1px solid #e5e7eb;
    box-shadow: 0 3px 10px rgba(0,0,0,0.04);
  }

  .card strong {
    color: var(--primary);
  }

  /* VALUES */
  .value {
    background: white;
    padding: 18px;
    border-left: 4px solid var(--primary);
    border-radius: 8px;
  }

  /* CTA */
  .cta {
    background: var(--dark);
    color: white;
    text-align: center;
    padding: 70px 20px;
  }

  .cta h2 {
    color: white;
  }

</style>
</head>

