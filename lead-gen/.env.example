# Email Configuration
EMAIL_API_KEY=your_sendgrid_api_key_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Email Settings
SENDER_EMAIL=info@nexpaksolutions.co.za
SENDER_NAME=NeXPak Solutions

# Database
DB_PATH=./db/leads.db

# Scraper Settings
PROXY_URL=
SCRAPER_TIMEOUT=10000
MAX_CONCURRENT_REQUESTS=5

# System Settings
NODE_ENV=production
LOG_LEVEL=info

# Daily lead target
DAILY_LEAD_TARGET=200

# Email delay (milliseconds between emails)
EMAIL_DELAY_MS=25000